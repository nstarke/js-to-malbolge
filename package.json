{
  "name": "js-to-malbolge",
  "version": "0.0.1",
  "description": "Transpile a subset of JavaScript to Malbolge Unshackled",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "js2mb": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-vendor": "bash scripts/fetch-vendor.sh"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.6.2",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "acorn": "^8.15.0"
  }
}
